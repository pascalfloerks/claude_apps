{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pedal Point",
  "version": "1.0.0",
  "identifier": "com.pascalfloerks.pedalpoint",
  "build": {
    "frontendDist": "../pedal-point"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pedal Point",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
